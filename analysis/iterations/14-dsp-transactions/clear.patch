+#  define CDJ_C674X_UNINITIALIZED __attribute__((uninitialized))
+# endif
+#endif
+#ifndef CDJ_C674X_UNINITIALIZED
+# define CDJ_C674X_UNINITIALIZED
+#endif
+
 
